<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="חיפוש באפליקציה, טקסט או פעולה"
            android:imeOptions="actionSearch"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:singleLine="true"
            android:inputType="text" />

        <Button
            android:id="@+id/searchClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:text="×"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:contentDescription="ניקוי החיפוש" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="טווח"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/searchToday" android:layout_width="wrap_content" android:layout_height="40dp" android:text="היום" android:textAllCaps="false" />
            <Button android:id="@+id/searchYesterday" android:layout_width="wrap_content" android:layout_height="40dp" android:text="אתמול" android:textAllCaps="false" />
            <Button android:id="@+id/searchWeek" android:layout_width="wrap_content" android:layout_height="40dp" android:text="7 ימים" android:textAllCaps="false" />
            <Button android:id="@+id/searchMonth" android:layout_width="wrap_content" android:layout_height="40dp" android:text="30 ימים" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="סינון נוסף"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/searchFrom" android:layout_width="wrap_content" android:layout_height="40dp" android:text="מתאריך" android:textAllCaps="false" />
            <Button android:id="@+id/searchTo" android:layout_width="wrap_content" android:layout_height="40dp" android:text="עד תאריך" android:textAllCaps="false" />
            <Button android:id="@+id/searchAppFilter" android:layout_width="wrap_content" android:layout_height="40dp" android:text="אפליקציה: הכול" android:textAllCaps="false" />
            <Button android:id="@+id/searchTypeFilter" android:layout_width="wrap_content" android:layout_height="40dp" android:text="פעולה: הכול" android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מציג:"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/searchRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/searchGo"
            android:layout_width="82dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:text="חפש"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_action" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchResultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="0 תוצאות"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/searchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="28dp"
        android:gravity="center"
        android:text="לא נמצאו פעולות בטווח הזה."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>