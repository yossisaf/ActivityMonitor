<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:padding="12dp" android:background="@drawable/bg_card" android:orientation="horizontal">
    <ImageView android:id="@+id/appIcon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="אייקון האפליקציה" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/appMetrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/appLast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" />
    </LinearLayout>
    <Switch android:id="@+id/appToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ניטור" android:contentDescription="הפעלה או כיבוי ניטור לאפליקציה" />
</LinearLayout>
