<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="18dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="הגדרות והרשאות" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="ההסרטה עצמה מופעלת מהמסך הראשי. כאן מגדירים הרשאות ושמירה." android:textSize="13sp" android:textColor="@color/text_secondary"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="הרשאות נדרשות" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
    <TextView android:id="@+id/accessibilityStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <Button android:id="@+id/openAccessibility" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="הגדרת זיהוי אפליקציות" android:textAllCaps="false" android:textSize="12sp"/>
   </LinearLayout>
   <TextView android:id="@+id/accessibilityDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
   <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/divider"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
    <TextView android:id="@+id/usageStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <Button android:id="@+id/openUsage" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:text="הגדרת נתוני שימוש" android:textAllCaps="false" android:textSize="12sp"/>
   </LinearLayout>
   <TextView android:id="@+id/usageDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="פעילות ברקע" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
   <TextView android:id="@+id/backgroundPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp"/>
   <TextView android:id="@+id/backgroundPermissionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
   <Button android:id="@+id/backgroundSetup" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="בדיקת הגדרות רקע" android:textAllCaps="false"/>
  </LinearLayout>
  <Button android:id="@+id/openRecordings" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="פתיחת הסרטונים השמורים" android:textAllCaps="false"/>
  <Button android:id="@+id/advancedToggle" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:gravity="start|center_vertical" android:paddingStart="14dp" android:text="אפשרויות מתקדמות  ›" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/bg_card"/>
  <LinearLayout android:id="@+id/advancedContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:visibility="gone" android:background="@drawable/bg_card" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="שמירת נתונים" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="משך שמירת היסטוריית הפעילות לפני מחיקה אוטומטית." android:textSize="12sp" android:textColor="@color/text_secondary"/>
   <EditText android:id="@+id/retentionDays" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="5dp" android:hint="מספר ימים (ברירת מחדל: 30)" android:inputType="number"/>
   <Button android:id="@+id/saveRetention" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="שמירת הגדרה" android:textAllCaps="false"/>
   <Button android:id="@+id/deleteHistory" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="5dp" android:text="מחיקת היסטוריית פעילות" android:textAllCaps="false" android:textColor="@color/error"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="14dp" android:background="@drawable/bg_card" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="אבטחה" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="נתוני האפליקציה המקומיים מוגנים באמצעות סיסמה." android:textSize="12sp" android:textColor="@color/text_secondary"/>
   <Button android:id="@+id/changePassword" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:text="שינוי סיסמה" android:textAllCaps="false"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>