<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/eventIcon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="אייקון האפליקציה" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/eventApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/eventTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/eventDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/eventText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
